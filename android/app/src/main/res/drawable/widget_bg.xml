<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass: tint, a soft top-left shine and a bright edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="@color/widget_glass" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="315" android:startColor="@color/widget_shine" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
            <stroke android:width="1dp" android:color="@color/widget_edge" />
        </shape>
    </item>
</layer-list>
